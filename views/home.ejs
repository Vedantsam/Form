<%- include('partials/header') %>

<div class="container">
    <h1>Welcome to My App</h1>
    <p style="color: #666; margin: 20px 0;">A full-stack application with server-side rendering using EJS</p>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 30px 0;">
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; border-radius: 10px; text-align: center;">
            <h2 style="font-size: 48px; margin-bottom: 10px;"><%= stats.totalRegistrations %></h2>
            <p style="font-size: 18px;">Total Users</p>
        </div>
        <div style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 30px; border-radius: 10px; text-align: center;">
            <h2 style="font-size: 48px; margin-bottom: 10px;"><%= stats.totalContacts %></h2>
            <p style="font-size: 18px;">Contact Messages</p>
        </div>
        <div style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; padding: 30px; border-radius: 10px; text-align: center;">
            <h2 style="font-size: 48px; margin-bottom: 10px;"><%= stats.pendingContacts %></h2>
            <p style="font-size: 18px;">Pending Contacts</p>
        </div>
    </div>
    
    <div style="margin-top: 40px;">
        <h2 style="color: #333; margin-bottom: 20px;">Quick Actions</h2>
        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
            <a href="/register" style="background: #667eea; color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px; display: inline-block;">
                Register New User
            </a>
            <a href="/contact" style="background: #764ba2; color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px; display: inline-block;">
                Contact Us
            </a>
            <a href="/dashboard" style="background: #4facfe; color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px; display: inline-block;">
                View Dashboard
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>