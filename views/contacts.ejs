<%- include('partials/header') %>

<div class="container">
    <h1>Contact Submissions</h1>
    <p class="text-muted mb-20">Total: <%= totalContacts %> messages</p>
    
    <% if (contacts.length === 0) { %>
        <p class="text-center text-muted" style="padding: 40px;">No contact submissions yet.</p>
    <% } else { %>
        <div>
            <% contacts.forEach(contact => { %>
                <div class="contact-card <%= contact.status %>">
                    <div class="contact-header">
                        <h3><%= contact.name %></h3>
                        <span class="status-badge <%= contact.status %>">
                            <%= contact.status.toUpperCase() %>
                        </span>
                    </div>
                    <p class="text-muted"><strong>Email:</strong> <%= contact.email %></p>
                    <p class="text-muted"><strong>Subject:</strong> <%= contact.subject %></p>
                    <p style="color: #333; margin: 15px 0; line-height: 1.6;"><%= contact.message %></p>
                    <p class="text-muted text-small">
                        Submitted: <%= new Date(contact.submittedAt).toLocaleString() %>
                    </p>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>